{
  "description": "Guards Bash, file, MCP, scheduler and message tool calls (hooks/guard.mjs): denies operator-session writes (OPR-01), merge messages without the review trailer (DEC-08) and destructive git/GitHub actions, and asks the owner on shared ones; also validates OKF docs after edits, records pushes in the session ledger and hands the operator its file at session start. A guard timeout or crash blocks the call (onFailure: block). Detail: docs/threat-model.md and README.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|Read|Grep|Glob|mcp__.*|CronCreate|CronDelete|CronList|ScheduleWakeup|RemoteTrigger|SendMessage|PushNotification|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.sh\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/okf-check.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/capture.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/operator-context.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
