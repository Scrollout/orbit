{
  "description": "After Write/Edit under the OKF bundle, run validate-okf (silent without a bundle or node); at session start, resume or compaction in the main checkout, hand .agents/operator.md to the operator (silent without it)",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/okf-check.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/operator-context.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
